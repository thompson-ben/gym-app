# Splitmate environment variables. Copy to .env.local and fill in.
# Both values are public (they ship to the browser); data is protected by Row Level Security.
# No service-role key is required by the app.

# Supabase project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key.
# Local: printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign in with Apple / Google buttons (server-side, not secret). List only providers already
# switched on in Supabase → Authentication → Sign In / Providers. Unset: email only.
# AUTH_PROVIDERS=apple,google
